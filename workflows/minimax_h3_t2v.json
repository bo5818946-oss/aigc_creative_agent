{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "MiniMax H3 权重"},
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "H3 文本编码器"},
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "视频 VAE"},
    "inputs": {"vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "音频 VAE"},
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}
  },
  "5": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {"title": "H3 条件与 latent"},
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": ["9", 1]
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Turbo LoRA"},
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "7": {
    "class_type": "PrimitiveBoolean",
    "_meta": {"title": "Turbo 开关"},
    "inputs": {"value": false}
  },
  "8": {
    "class_type": "ComfySwitchNode",
    "_meta": {"title": "模型选择"},
    "inputs": {"switch": ["7", 0], "on_false": ["1", 0], "on_true": ["6", 0]}
  },
  "9": {
    "class_type": "ComfyMathExpression",
    "_meta": {"title": "秒数换算帧数（17k+5 网格）"},
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": ["10", 0]
    }
  },
  "10": {
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Studio Duration (seconds)",
      "studio_clips": [5, 10]
    },
    "inputs": {"value": 5.0}
  },
  "11": {
    "class_type": "PrimitiveInt",
    "_meta": {"title": "全量步数"},
    "inputs": {"value": 20}
  },
  "12": {
    "class_type": "PrimitiveInt",
    "_meta": {"title": "Turbo 步数"},
    "inputs": {"value": 8}
  },
  "13": {
    "class_type": "ComfySwitchNode",
    "_meta": {"title": "步数选择"},
    "inputs": {"switch": ["7", 0], "on_false": ["11", 0], "on_true": ["12", 0]}
  },
  "14": {
    "class_type": "BasicScheduler",
    "_meta": {"title": "调度"},
    "inputs": {
      "model": ["8", 0],
      "scheduler": "simple",
      "steps": ["13", 0],
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "采样器"},
    "inputs": {"sampler_name": "res_multistep"}
  },
  "16": {
    "class_type": "RandomNoise",
    "_meta": {"title": "噪声"},
    "inputs": {"noise_seed": 42}
  },
  "17": {
    "class_type": "BasicGuider",
    "_meta": {"title": "引导"},
    "inputs": {"model": ["8", 0], "conditioning": ["5", 0]}
  },
  "18": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "采样"},
    "inputs": {
      "noise": ["16", 0],
      "guider": ["17", 0],
      "sampler": ["15", 0],
      "sigmas": ["14", 0],
      "latent_image": ["5", 1]
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "_meta": {"title": "视频解码"},
    "inputs": {"samples": ["18", 0], "vae": ["3", 0]}
  },
  "20": {
    "class_type": "VAEDecodeAudio",
    "_meta": {"title": "音频解码"},
    "inputs": {"samples": ["18", 0], "vae": ["4", 0]}
  },
  "21": {
    "class_type": "CreateVideo",
    "_meta": {"title": "合成视频"},
    "inputs": {
      "images": ["19", 0],
      "audio": ["20", 0],
      "fps": 24.0,
      "bit_depth": 8,
      "color_space": "sRGB",
      "codec": "none"
    }
  },
  "22": {
    "class_type": "SaveVideo",
    "_meta": {"title": "保存"},
    "inputs": {
      "video": ["21", 0],
      "filename_prefix": "aigc/h3",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    }
  }
}
